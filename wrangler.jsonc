{
  "name": "pending-dashboard",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "keep_vars": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "CHAT_ROOM", "class_name": "ChatRoom" }]
  },
  "migrations": [{ "tag": "v1-chat", "new_sqlite_classes": ["ChatRoom"] }],
  "kv_namespaces": [
    {
      "binding": "DASH_KV",
      "id": "ffb7f8c781ea4e119b2ac29811ab3cb7"
    }
  ]
}
